{
  "Name": "UCL-solar-bifacial",
  "Title": "Solar Bifacial Statistics",
  "CollectionGroup": "Solar",
  "Themes": [
    "renewable-energy"
  ],
  "Tags": [
    "Solar",
    "Bifacial"
  ],
  "Description": "On-demand bifacial photovoltaic potential statistics (2020 vs 2022) for a user-drawn AOI over GB, Ireland or France. Returns area, installable capacity, monofacial yield and bifacial gain derived from UCL's 10 m PVout+ products.",
  "Resources": [
    {
      "Name": "Collection-only",
      "OverwriteBBox": [-10.5, 49.8, 2.0, 55.8]
    }
  ],
  "Process": {
    "Name": "bifacial_indicator",
    "JsonForm": "https://raw.githubusercontent.com/gtif-ukif/gtif-ukif-assets/refs/heads/main/collections/UCL-solar-bifacial/jsonform.json",
    "VegaDefinition": "https://raw.githubusercontent.com/gtif-ukif/gtif-ukif-assets/refs/heads/main/collections/UCL-solar-bifacial/vega.json",
    "EndPoints": [
      {
        "Identifier": "bifacial_stats",
        "Url": "https://pygeoapi-eoxhub.workspace.gtif-ukif.hub-otc.eox.at/processes/execute-ucl-bifacial-stats-template/execution",
        "Method": "POST",
        "EndPoint": "eoxhub_workspaces",
        "Body": "https://raw.githubusercontent.com/gtif-ukif/gtif-ukif-assets/refs/heads/main/collections/UCL-solar-bifacial/body.json",
        "Type": "application/json"
      }
    ]
  },
  "BaseLayers": [
    {
      "id": "OSM",
      "name": "OSM Background",
      "url": "https://s2maps-tiles.eu/wmts/1.0.0/osm_3857/default/g/{z}/{y}/{x}.jpeg",
      "media_type": "image/jpeg",
      "attribution": "{ OSM: Data &copy; <a href=\"http://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a> contributors and <a href=\"//maps.eox.at/#data\" target=\"_blank\">others</a>, Rendering &copy; <a href=\"http://eox.at\" target=\"_blank\">EOX</a> }",
      "protocol": "xyz",
      "visible": true
    },
    {
      "id": "terrain-light",
      "name": "Terrain Light",
      "url": "https://s2maps-tiles.eu/wmts/1.0.0/terrain-light_3857/default/g/{z}/{y}/{x}.jpeg",
      "media_type": "image/jpeg",
      "attribution": "{ Terrain: Rendering &copy; <a href=\"http://eox.at\" target=\"_blank\">EOX</a> }",
      "protocol": "xyz",
      "visible": false
    }
  ],
  "Agency": [
    "UCL"
  ]
}
